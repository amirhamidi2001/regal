# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SETTINGS_MODULE=config.settings.prod
# This path is obscurity, not a security control.
DJANGO_ADMIN_URL=internal-admin/
DJANGO_SECRET_KEY=change-me-generate-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
# Must be true in production behind TLS.
DJANGO_SECURE_SSL=false
DJANGO_LOG_LEVEL=INFO
POSTGRES_DB=regal
POSTGRES_USER=regal
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
GUNICORN_WORKERS=3
RUN_COLLECTSTATIC=1
# S3-compatible service endpoint URL.
S3_ENDPOINT_URL=https://s3.example.com
# Placeholder access key; replace locally and never commit credentials.
S3_ACCESS_KEY_ID=change-me
# Placeholder secret key; replace locally and never commit credentials.
S3_SECRET_ACCESS_KEY=change-me
# Bucket for product media.
S3_BUCKET_NAME=regal-media
# Public base URL for media objects.
S3_PUBLIC_BASE_URL=https://media.example.com
# Optional S3 region (leave blank when the service does not use one).
S3_REGION_NAME=
# S3 bucket addressing mode (auto, path, or virtual).
S3_ADDRESSING_STYLE=auto
